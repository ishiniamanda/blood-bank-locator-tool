<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="app.DonorController">

    <!-- TOP -->
    <top>
        <HBox style="-fx-background-color:#c0392b; -fx-padding:15;">
            <Label text="DONOR MANAGEMENT PANEL"
                   style="-fx-text-fill:white; -fx-font-size:18px;"/>
        </HBox>
    </top>

    <!-- CENTER TABLE -->
    <center>
        <TableView fx:id="donorTable">
            <columns>
                <TableColumn fx:id="nameCol" text="Name" prefWidth="150"/>
                <TableColumn fx:id="bloodCol" text="Blood Type" prefWidth="120"/>
                <TableColumn fx:id="priorityCol" text="Priority" prefWidth="100"/>
            </columns>
        </TableView>
    </center>

    <!-- BOTTOM INPUT -->
    <bottom>
        <HBox spacing="10" style="-fx-padding:10;">
            <TextField fx:id="nameField" promptText="Name"/>
            <TextField fx:id="bloodField" promptText="Blood Type"/>
            <TextField fx:id="priorityField" promptText="Priority (1-5)"/>
            <Button text="Add Donor" onAction="#addDonor"/>
        </HBox>
    </bottom>

</BorderPane>